# The website (Vercel). Copy to web/.env.local for local runs; in production
# set these in the Vercel project's environment variables.

# Crew dashboard: the EU Supabase project's URL and *anon* (public) key.
# Never the service_role key.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Privacy page (/privacy). All optional: without them the page keeps its
# unnamed wording and points to the in-app Feedback button.
# Public contact address.
VITE_CONTACT_EMAIL=
# Who runs Hivo (the GDPR data controller), e.g. "Jane Doe". Shown as
# "Hivo is run by <name>".
VITE_OPERATOR_NAME=
# Optional postal address shown after the name.
VITE_OPERATOR_ADDRESS=
